# Copy to .env and run `supabase start` to enable the Postgres backend.
#
#   cp .env.example .env
#   supabase start          # prints the API URL + anon key
#   npx expo start --clear  # --clear so Expo picks up the new env
#
# The values below are the Supabase CLI local defaults (same on every machine).
# The anon key is public by design and protected by Row Level Security.
#
# On a physical device replace `localhost` with your computer's LAN IP
# (e.g. http://192.168.1.50:54321), since `localhost` resolves to the device.

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Existing AI provider key (unchanged) — see src/services/openaiService.js
# EXPO_PUBLIC_GROQ_API_KEY=
